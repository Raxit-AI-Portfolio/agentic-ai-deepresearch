# Copy this file to .env and fill in real values. Never commit .env itself.

# Hugging Face token — only needed if a model/tokenizer is pulled from the Hub.
HF_TOKEN=

# Serper.dev API key — powers web search (build_search_tool).
SERPER_API_KEY=

# Unsplash API access key — powers internet_image_content.
UNSPLASH_ACCESS_KEY=

# Google API key (or GEMINI_API_KEY) — required when ResearchConfig.llm_provider
# is "gemini-2.5-flash-lite" (the default), and optionally enables the
# Gemini-backed vision/SFW checker on generated media.
GOOGLE_API_KEY=

# --- Optional overrides ---

# Where run data (outlines, extracted reference text, exports) is written.
# DEEP_RESEARCH_DATA_DIR=/tmp/deep_research_runs

# Which LLM backend to use: "gemini-2.5-flash-lite" (default) or "gemma_7b"
# (local GGUF model via llama-cpp-python).
# DEEP_RESEARCH_LLM_PROVIDER=gemini-2.5-flash-lite

# Path to the local .gguf model file, only used when DEEP_RESEARCH_LLM_PROVIDER=gemma_7b.
# DEEP_RESEARCH_MODEL_PATH=models/gemma-7b-it-Q4_K_M.gguf
